# Kconfig fragment for the firmware integration of ww_log v2.
#
# NOT read by the PC simulator -- the sim gets the same symbols from
# scripts/log/log_config.json via `gen_log_map.py --autoconf`. This file is the
# on-target equivalent; keep the two in step when a knob is added.
#
# Every symbol below already has a fallback in the headers, so a build that
# selects none of them still compiles with the documented defaults.

menu "New log module (ww_log v2)"

config N_LOG
    bool "Enable the new log module"
    default n
    help
      This option enables the new log module.

choice
    prompt "Log Mode"
    depends on N_LOG
    default N_LOG_MODE_STRING

    config N_LOG_MODE_STRING
        bool "string"
        help
          Plain text log output. Readable but large: the format strings stay in
          the image.

    config N_LOG_MODE_ENCODE
        bool "encode"
        help
          Encoded log output. Each entry becomes a 4-byte header plus U32
          parameters; the text lives in ww_log_map.json on the host and is
          restored by the decoder.

    config N_LOG_MODE_DISABLE
        bool "disable"
        help
          No log output. Every N_LOG_* macro expands to nothing.
endchoice

# --- Backends ---------------------------------------------------------------

config N_LOG_BACKEND_UART
    bool "Enable UART log output"
    depends on N_LOG && (N_LOG_MODE_STRING || N_LOG_MODE_ENCODE)
    default y if N_LOG_MODE_STRING

config N_LOG_BACKEND_RAM
    bool "Enable RAM log output"
    depends on N_LOG && N_LOG_MODE_ENCODE
    help
      Ring buffer in the power-loss-retained DLM maintain region. Also the
      source the external backend drains, so EXT_MEM requires this.

config N_LOG_BACKEND_EXT_MEM
    bool "Enable external memory log output"
    depends on N_LOG && N_LOG_MODE_ENCODE && N_LOG_BACKEND_RAM
    help
      Append-only log in the external LOG partition (EEPROM / SPI NOR). It has
      no storage of its own -- it copies whole entries out of the RAM ring, so
      N_LOG_BACKEND_RAM is required. Selecting it without RAM is rejected at
      compile time by n_ww_log_storage.h.

# --- Level thresholds -------------------------------------------------------

choice
    prompt "Compile-time level threshold"
    depends on N_LOG && !N_LOG_MODE_DISABLE
    default N_LOG_COMPILE_THRESHOLD_DBG
    help
      Entries above this level are compiled out entirely (zero code size), so
      this is the knob that trades debuggability for image size.

    config N_LOG_COMPILE_THRESHOLD_ERR
        bool "ERR only"
    config N_LOG_COMPILE_THRESHOLD_WRN
        bool "ERR + WRN"
    config N_LOG_COMPILE_THRESHOLD_INF
        bool "ERR + WRN + INF"
    config N_LOG_COMPILE_THRESHOLD_DBG
        bool "everything (ERR + WRN + INF + DBG)"
endchoice

choice
    prompt "Level persisted to external storage"
    depends on N_LOG_BACKEND_EXT_MEM
    default N_LOG_EXT_LEVEL_THRESHOLD_WRN
    help
      The RAM ring keeps every entry that passed the runtime filter; only
      entries at or below this level are copied on to external storage when the
      ring is flushed. Keeping it strict is what makes the archive last.

    config N_LOG_EXT_LEVEL_THRESHOLD_ERR
        bool "ERR only"
    config N_LOG_EXT_LEVEL_THRESHOLD_WRN
        bool "ERR + WRN"
    config N_LOG_EXT_LEVEL_THRESHOLD_INF
        bool "ERR + WRN + INF"
    config N_LOG_EXT_LEVEL_THRESHOLD_DBG
        bool "everything"
endchoice

# --- External storage behaviour ---------------------------------------------

choice
    prompt "Behaviour when the LOG partition fills up"
    depends on N_LOG_BACKEND_EXT_MEM
    default N_LOG_EXT_FULL_FREEZE
    help
      The archive is an append-only stream, so there is no per-slot rolling
      window: it is one or the other.

    config N_LOG_EXT_FULL_FREEZE
        bool "freeze (keep the earliest logs)"
        help
          Stop appending once full. The tail is first topped up with as many
          whole entries as fit, and LOG_FLAG_EXT_FULL is set in the RAM header
          so the host can tell "archive full" from "device went quiet".

    config N_LOG_EXT_FULL_ERASE
        bool "erase (keep the newest logs)"
        help
          Wipe the partition and restart the stream. Note this also discards
          logs from earlier firmware versions.
endchoice

config N_LOG_EXT_FLUSH_MARKER
    bool "Prepend a timestamp marker to each flush batch"
    depends on N_LOG_BACKEND_EXT_MEM
    default y
    help
      Adds an 8-byte [marker][tick] record to the first data-bearing flush of
      each flush-task wake, so the host can split the append stream per flush.
      Costs 8 bytes per wake.

# --- Tuning -----------------------------------------------------------------

config N_LOG_RAM_FLUSH_THRESHOLD
    int "RAM bytes pending before a flush is signalled"
    depends on N_LOG_BACKEND_EXT_MEM
    default 480
    help
      A writer signals the flush task once this many bytes are pending. The
      time-based trigger (N_LOG_FLUSH_TIMEOUT_MS) still covers the quiet case.

config N_LOG_EXT_FLUSH_STAGE_SIZE
    int "Per-flush staging buffer size (bytes)"
    depends on N_LOG_BACKEND_EXT_MEM
    default 256
    help
      Bounds both the RAM bytes walked per log_ram_flush() call and the static
      staging buffer. Must exceed one maximum-size entry (64 bytes). A backlog
      drains over successive calls.

config N_LOG_WRITE_TIMEOUT_MS
    int "Mutex acquire timeout on the writer path (ms)"
    depends on N_LOG_BACKEND_RAM
    default 6

config N_LOG_FLUSH_TIMEOUT_MS
    int "Flush task wake interval (ms)"
    depends on N_LOG_BACKEND_EXT_MEM
    default 10000
    help
      Time-based flush trigger: whatever is pending gets written even if it
      never reaches N_LOG_RAM_FLUSH_THRESHOLD.

config N_LOG_FLUSH_TASK_STACK_SIZE
    int "Flush task stack size (words)"
    depends on N_LOG_BACKEND_EXT_MEM
    default 256

config N_LOG_FLUSH_TASK_PRIORITY
    int "Flush task priority"
    depends on N_LOG_BACKEND_EXT_MEM
    default 1

endmenu
